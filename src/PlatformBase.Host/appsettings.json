{
  // ========== ASP.NET Core 日志级别 ==========
  // 此处为基础配置，结构化日志由Serilog接管（见下方Serilog节）
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // 允许访问的主机名，* 表示不限制
  "AllowedHosts": "*",

  // ========== 数据库 ==========
  "Database": {
    // 数据库类型：Sqlite / SqlServer / MySql
    "Provider": "Sqlite",
    // 连接字符串（Provider=Sqlite时为文件路径；SqlServer/MySql时填写完整连接串）
    "ConnectionString": "Data Source=app.db",
    // 是否输出敏感数据日志（含SQL参数值），仅开发环境开启
    "EnableSensitiveDataLogging": false
  },

  // ========== 结构化日志 (Serilog) ==========
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        // 控制台输出
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        // 文件输出：每天一个文件，保留最近30天
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  // ========== 跨域配置 (CORS) ==========
  "Cors": {
    // 允许的域名列表，生产环境应改为具体域名，不允许使用 *
    "AllowedOrigins": ["*"]
  }
}
