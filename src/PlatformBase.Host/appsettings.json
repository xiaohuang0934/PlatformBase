{
  // ========== ASP.NET Core 日志级别 ==========
  // 此处为基础配置，结构化日志由Serilog接管（见下方Serilog节）
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // 允许访问的主机名，* 表示不限制
  "AllowedHosts": "*",

  // ========== 数据库 ==========
  "Database": {
    // 数据库类型：Sqlite / SqlServer / MySql
    "Provider": "Sqlite",
    // 连接字符串（Provider=Sqlite时为文件路径；SqlServer/MySql时填写完整连接串）
    "ConnectionString": "Data Source=app.db",
    // 是否输出敏感数据日志（含SQL参数值），仅开发环境开启
    "EnableSensitiveDataLogging": false
  },

  // ========== JWT 认证配置 ==========
  "Jwt": {
    // 签名密钥（至少 32 个字符，生产环境从环境变量或 Secret Manager 注入）
    "Secret": "PlatformBase-Super-Secret-Key-Minimum-32-Chars!!",
    // Token 签发方（与 IdentityServer Authority 一致）
    "Issuer": "http://localhost:5098",
    // Token 目标受众
    "Audience": "api1",
    // Access Token 有效期（分钟），默认 60 分钟
    "AccessTokenLifetimeMinutes": 60
  },

  // ========== IdentityServer4 配置 ==========
  "IdentityServer": {
    // OAuth2/OIDC 授权服务器地址
    "Authority": "http://localhost:5098",
    // 生产环境签名证书来源：File / Base64 / Store
    "SigningCertSource": "File",
    // 证书文件路径（SigningCertSource=File 时生效）
    "SigningCertPath": "",
    // 证书密码
    "SigningCertPassword": ""
  },

  // ========== Redis 缓存配置 ==========
  "Redis": {
    // Redis 连接字符串
    "ConnectionString": "localhost:6379",
    // 默认数据库编号（0-15）
    "DefaultDatabase": 0,
    // 是否启用 Redis（设为 false 时直接查库，不缓存）
    "Enabled": true
  },

  // ========== 结构化日志 (Serilog) ==========
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        // 控制台输出
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        // 文件输出：每天一个文件，保留最近30天
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  // ========== 跨域配置 (CORS) ==========
  "Cors": {
    // 允许的域名列表，生产环境应改为具体域名，不允许使用 *
    "AllowedOrigins": ["*"]
  }
}
