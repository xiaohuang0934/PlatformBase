{
  // ========== 开发环境专属配置 ==========
  // 此文件仅当 ASPNETCORE_ENVIRONMENT=Development 时加载
  // 会覆盖 appsettings.json 中的同名配置

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication.JwtBearer": "Debug",
      "Microsoft.IdentityModel": "Debug"
    }
  },

  // 开发环境开启SQL敏感数据日志，便于调试
  "Database": {
    "EnableSensitiveDataLogging": true
  },

  // 开发环境 Redis 连接（未安装时设为 false，自动降级到数据库）
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": false
  }
}
